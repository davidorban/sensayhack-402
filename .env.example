# Sensay API Configuration
SENSAY_API_KEY=your_sensay_api_key_here
SENSAY_ORG_ID=your_organization_id_here
SENSAY_REPLICA_ID=your_replica_uuid_here
SENSAY_USER_ID=test-user-1  # Default test user ID

# Coinbase x402 Configuration
X402_VERIFICATION_URL=https://api.cdp.coinbase.com/x402/verify
X402_PAYMENT_AMOUNT=10  # Test amount in smallest unit
X402_ASSET=USDC  # Test payment asset
X402_CHAIN=base  # Test blockchain network

# Server Configuration
PORT=3000  # Port for the Express server
NODE_ENV=development  # Set to 'production' in production

# Session Configuration (if using sessions)
# SESSION_SECRET=your_session_secret_here

# Redis Configuration (if using Redis for session/cache)
# REDIS_URL=redis://localhost:6379
# REDIS_TTL=86400  # 24 hours in seconds

# Logging
LOG_LEVEL=info  # error, warn, info, debug

# CORS Configuration (if needed)
# CORS_ORIGIN=http://localhost:3000
# CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE

# Rate Limiting (if implemented)
# RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
# RATE_LIMIT_MAX_REQUESTS=100  # Max requests per window per IP

# Optional: Payment Processor Webhook Secret
# PAYMENT_WEBHOOK_SECRET=your_webhook_secret_here
