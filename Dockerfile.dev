FROM node:18-alpine

# Install development tools
RUN apk add --no-cache python3 make g++ git

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies
RUN npm install

# Copy application code
COPY . .

# Expose port and debugger port
EXPOSE 3000 9229

# Start with hot reload
CMD ["npm", "run", "dev"]